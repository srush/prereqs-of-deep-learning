-- Text-free geometric illustration; fixed layout for reproducibility.
forall Diagram `illustration` {
  shape openDisk = Circle {
    center: (-215, 0)
    r: 140
    fillColor: rgba(0.87,0.93,0.97,0.4)
    strokeColor: rgba(0.19,0.37,0.49,1)
    strokeWidth: 2
    strokeDasharray: "7 6"
  }
  shape missingCenter = Circle {
    center: (-215, 0)
    r: 5
    fillColor: rgba(1,1,1,1)
    strokeColor: rgba(0.19,0.37,0.49,1)
    strokeWidth: 1.7
  }
  shape sequence0 = Circle {
    center: (-285, 0)
    r: 2.6
    fillColor: rgba(0.19,0.37,0.49,1)
    strokeColor: rgba(0.19,0.37,0.49,1)
    strokeWidth: 1.7
  }
  shape sequence1 = Circle {
    center: (-255, 0)
    r: 2.6
    fillColor: rgba(0.19,0.37,0.49,1)
    strokeColor: rgba(0.19,0.37,0.49,1)
    strokeWidth: 1.7
  }
  shape sequence2 = Circle {
    center: (-238, 0)
