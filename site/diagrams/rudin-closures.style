    fillColor: rgba(0.19,0.37,0.49,1)
    strokeColor: rgba(0.19,0.37,0.49,1)
    strokeWidth: 1.7
  }
  shape sequence3 = Circle {
    center: (-229, 0)
    r: 2.6
    fillColor: rgba(0.19,0.37,0.49,1)
    strokeColor: rgba(0.19,0.37,0.49,1)
    strokeWidth: 1.7
  }
  shape arrow = Line {
    start: (-28, 0)
    end: (28, 0)
    strokeColor: rgba(0.45,0.57,0.64,0.35)
    strokeWidth: 2
  }
  shape arrowUpper = Line {
    start: (28, 0)
    end: (18, 8)
    strokeColor: rgba(0.45,0.57,0.64,0.35)
    strokeWidth: 2
  }
  shape arrowLower = Line {
    start: (28, 0)
    end: (18, -8)
    strokeColor: rgba(0.45,0.57,0.64,0.35)
    strokeWidth: 2
  }
  shape closedDisk = Circle {
    center: (215, 0)
    r: 140
    fillColor: rgba(0.87,0.93,0.97,0.4)
    strokeColor: rgba(0.75,0.44,0.14,1)
    strokeWidth: 3
  }
  shape addedCenter = Circle {
    center: (215, 0)
    r: 5
    fillColor: rgba(0.75,0.44,0.14,1)
    strokeColor: rgba(0.75,0.44,0.14,1)
    strokeWidth: 1.7
  }
  shape sameSequence0 = Circle {
    center: (145, 0)
    r: 2.6
    fillColor: rgba(0.19,0.37,0.49,1)
    strokeColor: rgba(0.19,0.37,0.49,1)
    strokeWidth: 1.7
  }
  shape sameSequence1 = Circle {
    center: (175, 0)
    r: 2.6
    fillColor: rgba(0.19,0.37,0.49,1)
    strokeColor: rgba(0.19,0.37,0.49,1)
    strokeWidth: 1.7
