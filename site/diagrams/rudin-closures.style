    r: 2.6
    fillColor: rgba(0.19,0.37,0.49,1)
    strokeColor: rgba(0.19,0.37,0.49,1)
    strokeWidth: 1.7
  }
  layer openDisk below missingCenter
  layer missingCenter below sequence0
  layer sequence0 below sequence1
  layer sequence1 below sequence2
  layer sequence2 below sequence3
  layer sequence3 below arrow
  layer arrow below arrowUpper
  layer arrowUpper below arrowLower
  layer arrowLower below closedDisk
  layer closedDisk below addedCenter
  layer addedCenter below sameSequence0
  layer sameSequence0 below sameSequence1
  layer sameSequence1 below sameSequence2
  layer sameSequence2 below sameSequence3
